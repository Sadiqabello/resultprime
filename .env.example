# ────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. NEVER commit real secrets.
# ────────────────────────────────────────────────────────────────

# Supabase — public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — service role (SERVER ONLY — bypasses RLS, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Root domain for subdomain-per-school routing (Phase 2). e.g. rps.com
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Cron / background job protection (shared secret checked in app/api/cron/*)
CRON_SECRET=generate-a-long-random-string

# Optional integrations (add as features land)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# SENTRY_DSN=
# PAYSTACK_SECRET_KEY=

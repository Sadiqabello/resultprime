# ────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. NEVER commit real secrets.
# Env var names are CASE-SENSITIVE — match them exactly (e.g. EMAIL_FROM).
# ────────────────────────────────────────────────────────────────

# ── Required (validated at boot in config/env.ts) ───────────────────────────

# Supabase — public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — service role (SERVER ONLY — bypasses RLS, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Root domain for subdomain-per-school routing. e.g. resultprime.com
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Cron / background job protection (Bearer secret checked in app/api/cron/*). Min 16 chars.
CRON_SECRET=generate-a-long-random-string

# ── Email (transactional) ───────────────────────────────────────────────────
# Result-published emails + account password-setup links. Both must be set to
# send real email; otherwise the app uses a dev "log transport" (prints, no send).
# EMAIL_FROM must be a verified sender on your Resend domain.
RESEND_API_KEY=
EMAIL_FROM=Result Prime <noreply@yourdomain.com>

# ── Payments (Paystack) ─────────────────────────────────────────────────────
# sk_test_… in dev, sk_live_… in prod. Also register the webhook in Paystack:
#   https://<your-app>/api/webhooks/payments
PAYSTACK_SECRET_KEY=

# ── WhatsApp / SMS (Twilio) — optional ──────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ── Shared rate limiting — REQUIRED on serverless / multi-instance ──────────
# The in-memory limiter is per-instance, so on Vercel/Lambda or >1 replica the
# login brute-force + PDF/compute/import limits don't hold globally. Set these
# (Upstash Redis) in any multi-instance deployment.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Error tracking — optional but recommended in prod ───────────────────────
# Set the DSN and `npm i @sentry/nextjs`; lib/logger#captureException forwards to it.
SENTRY_DSN=
